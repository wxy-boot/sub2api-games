# 服务监听端口。docker-compose.yml 默认把宿主机 8790 映射到容器 8790。
PORT=8790

# 对外访问路径。反代到 https://你的域名/games/ 时填 /games；直接占用根路径就留空或 /。
# 注意：/ 与 /games 都不冲突，游戏页固定是 {BASE}/play/{id}。
PUBLIC_BASE_PATH=/games

# 大厅标题与副标题（副标题只写进 meta description，不在页面上显示）。
GAMES_TITLE=摸鱼小游戏
GAMES_SUBTITLE=sub2api 内置小游戏厅，含贪吃蛇等纯前端小游戏。

# 右上角“返回主站”的文案与地址。嵌进 sub2api 时填主站地址，独立部署可以留空隐藏。
GAMES_SITE_NAME=sub2api
GAMES_SITE_URL=

# 静态资源浏览器缓存秒数；文件内容变化时会自动换 ETag，所以可以放心开大。
GAMES_STATIC_MAX_AGE=3600

# 是否允许被 iframe 嵌入。设为 false 时会发送 X-Frame-Options: SAMEORIGIN。
GAMES_ALLOW_EMBED=true
